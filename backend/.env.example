# Database
DATABASE_URL=postgresql://user:password@localhost:5432/somela

# Voyage AI (for embeddings)
VOYAGE_API_KEY=voyage-xxxxx

# OpenAI / OpenRouter (for discovery agent)
# Option 1: Direct OpenAI
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o

# Option 2: OpenRouter (supports many providers)
# OPENROUTER_API_KEY=sk-or-v1-xxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o

# Anthropic (alternative agent - not currently used)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# YouCam API (for try-on)
YOUCAM_API_KEY=xxxxx
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_WEBHOOK_SECRET=whsec_xxxxx

# Server
PORT=3000
NODE_ENV=development
