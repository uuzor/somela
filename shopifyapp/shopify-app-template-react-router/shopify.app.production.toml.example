# Copy to shopify.app.production.toml and replace YOUR_PRODUCTION_DOMAIN.
client_id = "29f6f932a0aed3b070510b5205e576b4"
application_url = "https://YOUR_PRODUCTION_DOMAIN"
embedded = true
name = "OpenCommerceLens"

[build]
automatically_update_urls_on_dev = false

[access_scopes]
scopes = "read_products,read_inventory"
optional_scopes = []
use_legacy_install_flow = false

[webhooks]
api_version = "2025-10"

  [[webhooks.subscriptions]]
  uri = "/webhooks/compliance"
  compliance_topics = [ "customers/data_request", "customers/redact", "shop/redact" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/app/uninstalled"
  topics = [ "app/uninstalled" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/app/scopes_update"
  topics = [ "app/scopes_update" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/products/create"
  topics = [ "products/create" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/products/update"
  topics = [ "products/update" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/products/delete"
  topics = [ "products/delete" ]

[auth]
redirect_urls = [
  "https://YOUR_PRODUCTION_DOMAIN/auth/callback",
  "https://YOUR_PRODUCTION_DOMAIN/auth/shopify/callback",
  "https://YOUR_PRODUCTION_DOMAIN/api/auth/callback"
]
