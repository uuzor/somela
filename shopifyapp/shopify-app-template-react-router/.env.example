SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-domain.com
SCOPES=read_products,read_inventory
# Shared managed Postgres connection for catalogue, queue, and Shopify app state.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
VOYAGE_API_KEY=
SHOPIFY_BILLING_TEST=true
# Keep false until Shopify App Pricing is configured in Partner Dashboard.
SHOPIFY_BILLING_ENABLED=false
NODE_ENV=development
PORT=3000
